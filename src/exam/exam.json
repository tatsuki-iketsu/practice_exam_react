    "question" : "次のプログラムをコンパイル、実行するとどのような結果になりますか。\n 01|\u00A0 class\u00A0Parent\u00A0{ \n 02|\u00A0\u00A0\u00A0\u00A0\u00A0private\u00A0static\u00A0void\u00A0methodA()\u00A0{ \n 03|\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0System.out.println(\"static\u00A0Parent\u00A0methodA()\"); \n 04|\u00A0\u00A0\u00A0\u00A0\u00A0} \n 05|\u00A0\u00A0\u00A0\u00A0\u00A0private \u00A0void\u00A0methodB()\u00A0{ \n 06|\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0System.out.println(\"Parent#methodB()\"); \n 07|\u00A0\u00A0\u00A0\u00A0\u00A0} \n 08|\u00A0} \n 09|\u00A0class\u00A0Child\u00A0extends\u00A0Parent\u00A0{ \n 10|\u00A0\u00A0\u00A0\u00A0\u00A0public\u00A0static\u00A0void\u00A0methodA()\u00A0{ \n 11|\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0System.out.println(\"static\u00A0Child\u00A0methodA()\"); \n 12|\u00A0\u00A0\u00A0\u00A0\u00A0} \n 13|\u00A0\u00A0\u00A0\u00A0\u00A0public\u00A0void\u00A0methodB()\u00A0{ \n 14|\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0System.out.println(\"Child#methodB()\"); \n 15|\u00A0\u00A0\u00A0\u00A0\u00A0} \n 16|\u00A0} \n 17|\u00A0public\u00A0class\u00A0Main\u00A0{ \n 18|\u00A0\u00A0\u00A0\u00A0\u00A0public\u00A0static\u00A0void\u00A0main(String[]\u00A0args)\u00A0{ \n 19|\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0Parent\u00A0obj\u00A0=\u00A0new\u00A0Child(); \n 20|\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0Child.methodA(); \n 21|\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0obj.methodB(); \n 22|\u00A0\u00A0\u00A0\u00A0\u00A0} \n 23|\u00A0}",
